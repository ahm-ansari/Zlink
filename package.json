{
  "name": "zawajlink",
  "version": "1.0.0",
  "description": "ZawajLink matrimonial broker management portal for Qatar and GCC marriage agents.",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace backend"
  },
  "keywords": [
    "marriage",
    "broker",
    "matrimony",
    "matching",
    "crm"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
